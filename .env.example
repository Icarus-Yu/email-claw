# ========== 服务端口 ==========
PORT=3000

# ========== 数据库 ==========
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/emailclaw?schema=public"

# ========== 安全 / 鉴权 ==========
# JWT 签发密钥，至少 16 位；生产请使用 openssl rand -hex 32
JWT_SECRET=

# 用于加密 User.imapPassword 的对称密钥（任意字符串，会经 sha256 派生为 32 字节）
# 一旦设置切勿轻易更改，否则已加密的 IMAP 凭据将无法解密
ENCRYPTION_KEY=

# 飞书 bot 与后端之间的共享密钥（生产环境必填）
# bot 在调用 /api/feishu/webhook 时会带 X-Bot-Secret 头
FEISHU_BOT_SHARED_SECRET=

# ========== 引导用户（可选） ==========
# 如果设置了下面 IMAP_* 且 BOOTSTRAP_PASSWORD 不为空，
# 启动时若数据库尚无此邮箱用户，会自动注册并绑定邮箱
# 后续登录用 IMAP_USER + BOOTSTRAP_PASSWORD
BOOTSTRAP_PASSWORD=

IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_TLS=true
IMAP_ARCHIVE_BOX=Archive

# 引导用户默认接收飞书卡片的 open_id（可选）
DEFAULT_FEISHU_OPEN_ID=

# ========== 飞书 bot ==========
FEISHU_BOT_URL=http://localhost:3001

# ========== OpenClaw（可选） ==========
OPENCLAW_ENABLED=false
OPENCLAW_COMMAND=openclaw
OPENCLAW_AGENT_ID=email-claw
OPENCLAW_TIMEOUT_MS=30000
