# ========== 飞书应用配置 ==========
APP_ID=
APP_SECRET=

# ========== 机器人服务端口 ==========
PORT=3001

# ========== EmailClaw 后端地址 ==========
BACKEND_URL=http://localhost:3000

# ========== 卡片接收者 open_id ==========
# 开发调试时填写自己的飞书 open_id，启动后机器人会向此用户发送测试卡片
DEFAULT_OPEN_ID=

# ========== 后端共享密钥（必须与主后端 FEISHU_BOT_SHARED_SECRET 一致）==========
# 用于 webhook 调用鉴权，防止外部恶意请求伪装成 bot 操作邮件
FEISHU_BOT_SHARED_SECRET=
